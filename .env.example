# CloudNoteBridge Production Environment Variables for AWS / Docker

# Flask Secret Key (Generate a random string: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_key_here

# Port to expose on the host (Default 80 for HTTP)
PORT=80

# Database Credentials (used by MySQL container and Flask backend)
DB_USER=clouduser
DB_PASSWORD=choose_a_strong_database_password
DB_ROOT_PASSWORD=choose_a_strong_root_password

# Storage Provider: 'auto', 's3', or 'local'
STORAGE_PROVIDER=auto

# AWS S3 Cloud Storage Credentials (leave blank if using IAM instance profile or local storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-cloudnotebridge-notes-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Download Link Duration (seconds)
S3_PRESIGNED_URL_EXPIRATION=3600

# Security (Set to True once HTTPS is configured with SSL certificate)
SESSION_COOKIE_SECURE=False
CORS_ORIGINS=http://localhost,http://127.0.0.1
