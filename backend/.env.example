# CloudNoteBridge Backend Configuration Template
# Copy this file to .env and configure with your local environment values.

# Flask Application Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key-32-bytes

# Database Configuration
# For local MySQL:
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/cloudnotebridge
# Fallback for quick local development without MySQL:
# DATABASE_URL=sqlite:///cloudnotebridge.db

# Storage Provider: 'auto', 's3', or 'local'
# If set to 'auto' or 's3' with AWS credentials provided, AWS S3 is used.
# If unconfigured or set to 'local', the safe local development storage adapter is used.
STORAGE_PROVIDER=auto

# AWS S3 Cloud Storage Credentials (Required only when using AWS S3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-cloudnotebridge-private-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional: only if using temporary AWS IAM session tokens
AWS_SESSION_TOKEN=

# Pre-signed Download URL Validity Period (in seconds; default 3600 = 1 hour)
S3_PRESIGNED_URL_EXPIRATION=3600

# File Upload Limit in Megabytes (default 25 MB)
MAX_UPLOAD_SIZE_MB=25

# CORS Trusted Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Security (Set to True in HTTPS Production, False for HTTP localhost development)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# Server Binding
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=True
